APP_NAME="Fluxo Repasse"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
TERMS_VERSION=2026-11-18
AUTH_REQUIRE_EMAIL_VERIFICATION=false
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fluxo_repasse
DB_USERNAME=fluxo_repasse
DB_PASSWORD=
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
AUTH_GUARD=web
JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=20160
JWT_REFRESH_IAT=true
JWT_BLACKLIST_ENABLED=true
JWT_ALGO=HS256
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Login social com Google. O client secret permanece somente na API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${FRONTEND_URL}/auth/login"

# Cadastro público: use "log" localmente e SMTP em produção.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@fluxosistemas.com.br"
MAIL_FROM_NAME="${APP_NAME}"

LOG_API_REQUEST_SUMMARY=false


# Cadastro assistido (Macro 56). Provedores terceirizados; credenciais só na API.
# Sem token de placa: modo guiado/manual continua funcionando, sem simular consulta.
PLACAEFIPE_API_KEY=
# Parallelum: 500 requisições/dia sem autenticação; token opcional aumenta quota.
# Validar condições comerciais/licença antes de usar em produção SaaS.
PARALLELUM_FIPE_TOKEN=
# Provedor usado para alimentar o catálogo local: parallelum ou apifipe.
VEHICLE_CATALOG_PROVIDER=parallelum
# API FIPE paga; token somente no backend.
APIFIPE_API_BASE_URL=https://api.apifipe.com.br
APIFIPE_API_TOKEN=
