# Ambiente de QA isolado; não é imagem de produção.
FROM php:8.4-cli-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends git unzip zip libonig-dev libxml2-dev libzip-dev \
 && docker-php-ext-install -j"$(nproc)" pdo_mysql pdo_sqlite mbstring xml zip \
 && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
WORKDIR /workspace/api
